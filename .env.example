# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://khufu.io

# WhatsApp contact number. Write it as you want it displayed ("+", spaces ok);
# the wa.me link is derived by stripping everything but digits.
#
# ⚠️ This is Khufu's CONTACT CHANNEL, not just a footer link: every call-to-action
# in the lead-magnet nurture sequence is a wa.me deep link built from it. There is
# deliberately no booking calendar — do not reintroduce one.
NEXT_PUBLIC_WHATSAPP_NUMBER=+971 50 365 1761

# PostHog analytics — project "khufu.io". Only the key is configurable: the API
# host (/ingest proxy) and UI host are constants hardcoded in the provider.
NEXT_PUBLIC_POSTHOG_KEY=

# Resend — contact form email delivery
# Get an API key at https://resend.com. Without it, the form falls back to mailto.
RESEND_API_KEY=
# Verified sender (once khufu.io domain is verified in Resend, e.g. "Khufu <hello@khufu.io>").
# Defaults to Resend's onboarding sender for testing.
CONTACT_FROM_EMAIL=
# Where contact submissions are delivered. Defaults to hello@khufu.io.
CONTACT_TO_EMAIL=hello@khufu.io

# Lead magnets (/playbook, /build-vs-buy, /hire-checklist)
# Sender for the guide delivery + nurture sequence. Falls back to
# CONTACT_FROM_EMAIL, then to Resend's onboarding sender. NOTE: the onboarding
# sender can only deliver to the Resend account owner — verify the khufu.io
# domain in Resend before running ads, or leads get no email.
LEAD_FROM_EMAIL=
# NOTE: this deployment needs only SENDING access on its Resend key. The lead
# record is written to PostHog (write-only public key), never to Resend
# contacts, so no full-access key has to live on a public-facing site. HQ holds
# the full-access key locally and owns the contact list from there.
