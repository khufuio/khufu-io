# khufu.io — environment variables.
# Copy to `.env.local` and fill in. Every value here is intentionally EMPTY:
# this file documents what the app reads, never what the app is configured with.

# --- Site ---------------------------------------------------------------
# Absolute origin, no trailing slash — used by the sitemap, the canonical URLs
# and the JSON-LD. e.g. https://www.khufu.io
NEXT_PUBLIC_SITE_URL=

# --- Contact ------------------------------------------------------------
# WhatsApp number in display form (spaces and "+" allowed); the wa.me links
# strip it to digits themselves. Falls back to the number hard-coded in
# src/content/site.ts when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public booking page for the Sprint V1 call.
#
# ⚠️ WHAT GOES HERE: the URL of the Google Workspace appointment schedule
# « Sprint V1 — 30 min » (30-minute slots, Google Meet link generated
# automatically, Mon→Fri 10:00–14:00 UTC, minimum 24h notice). It is the same
# mechanism Clokizi's showcase uses (`NEXT_PUBLIC_DEMO_URL`): a PLAIN LINK, never
# an embedded iframe — a scheduler mounted on load costs LCP and CLS on a page
# under ad budget.
#
# ⚠️ LEAVING THIS EMPTY IS SAFE. The current schedule is hard-coded as a fallback
# in src/components/sprint/sprintContact.tsx, so production always has a working
# booking path even if the variable is never set — `NEXT_PUBLIC_*` is inlined at
# build time, and a forgotten variable would otherwise silently remove the main
# CTA of the one page carrying an ad budget. Set it to override the schedule
# without touching code (a redeploy is still required); set it to a blank value
# in code to take bookings offline, which hides the button and promotes the
# one-field email capture to main path.
#
# ⛔ NEVER the Clokizi schedule: a Khufu prospect must not land on a Clokizi slot.
NEXT_PUBLIC_SPRINT_BOOKING_URL=

# --- Email (Resend) -----------------------------------------------------
# Without a key, /api/contact answers 501 and the forms fall back to mailto.
RESEND_API_KEY=
# Inbox that receives contact-form submissions. Defaults to site.email.
CONTACT_TO_EMAIL=
# Verified sender for contact notifications, e.g. "Khufu <hello@khufu.io>".
CONTACT_FROM_EMAIL=
# Verified sender for lead-magnet delivery.
LEAD_FROM_EMAIL=

# --- Analytics ----------------------------------------------------------
# PostHog project key. Unset = no tracking is initialised at all.
NEXT_PUBLIC_POSTHOG_KEY=

# --- Scripts ------------------------------------------------------------
# Output directory for `npm run partner-kit`. Defaults to a path under $HOME.
PARTNER_KIT_DIR=
