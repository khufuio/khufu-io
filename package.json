{
  "name": "khufu-io",
  "private": true,
  "version": "2.0.0",
  "description": "Khufu.io — agence produit AI-native. Votre V1 en 1 semaine.",
  "author": "Khufu <hello@khufu.io>",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "pdfs": "tsx scripts/buildLeadMagnetPdfs.ts",
    "partner-kit": "tsx scripts/buildPartnerKit.ts",
    "typecheck": "tsc --noEmit",
    "check:sprint": "tsx scripts/checkSprintSlots.ts && tsx scripts/checkSprintLocales.ts",
    "check:sprint-html": "tsx scripts/checkSprintHtml.ts",
    "flyer": "tsx scripts/buildFlyer.ts",
    "capture:hero": "node scripts/captureSprintHero.mjs",
    "check:sprint-title": "node scripts/checkSprintHeroTitle.mjs",
    "check:linkedin": "node scripts/checkLinkedInTag.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "posthog-js": "^1.200.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "exceljs": "^4.4.0",
    "marked": "^18.0.13",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
